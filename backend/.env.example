# Copy to .env and fill in. Every setting can also be an environment variable.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://broker_app:broker_app@localhost:5432/broker_app
AUTO_CREATE_TABLES=true

# Long random value in production, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Browser origins allowed to call the API (the admin portal). JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# This backend's public address, used in links we email (HOD Approve/Deny). No trailing slash.
PUBLIC_BASE_URL=https://api.example.com

# mock = built-in demo data; live = Salesforce
SALESFORCE_MODE=mock
SALESFORCE_TOKEN_URL=https://login.salesforce.com/services/oauth2/token
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v68.0
# Account field for "broker added in Salesforce" and rejection-reason field, once they exist
SALESFORCE_PARTNER_ADDED_FIELD=
SALESFORCE_REJECTION_REASON_FIELD=
# Project__c checkbox that shows a project to brokers (checked = visible to all brokers)
SALESFORCE_PROJECT_VISIBLE_FIELD=Is_Available_For_Broker_App__c
# Apex REST endpoint that returns only broker-visible projects (empty = use the field above)
SALESFORCE_PROJECTS_ENDPOINT=/services/apexrest/v1/broker-app/projects
# Lead object (Lead) once the integration user can read/create it, and its project / channel-partner lookups
SALESFORCE_LEAD_OBJECT=
SALESFORCE_LEAD_PROJECT_FIELD=Project__c
SALESFORCE_LEAD_PARTNER_FIELD=Channel_Partner__c
# Salesforce's Apex endpoint that creates leads; leads are listed from the app's own copy (it can't list them)
SALESFORCE_LEADS_ENDPOINT=/services/apexrest/v1/broker-app/leads
# Lists a broker's Opportunities with their Stage (shown on converted leads). Empty = not used.
SALESFORCE_OPPORTUNITIES_ENDPOINT=/services/apexrest/v1/broker-app/opportunities
# Sent as company (required by Salesforce) when the lead form has no company field
SALESFORCE_LEAD_COMPANY=Individual Buyer
# JSON key for the submitting broker's Salesforce Account Id on each lead (Channel_Partner_Broker_Account__c)
SALESFORCE_LEAD_BROKER_KEY=channelPartnerAccountId
# Lead Status sent on new leads; empty = Salesforce's default (must be one of Salesforce's values)
SALESFORCE_LEAD_STATUS=
# Shared with Salesforce; they sign webhook calls with it (HMAC-SHA256, hex, X-Signature header)
# Salesforce Apex endpoint the broker account is POSTed to once an HOD/admin approves it; empty = standard REST API
SALESFORCE_BROKER_ACCOUNTS_ENDPOINT=/services/apexrest/v1/broker-accounts
# false = read accounts only through the Apex endpoints (GET check by mobile), details from our database;
# true = SOQL / sObject calls on the standard REST API
SALESFORCE_STANDARD_API=false
# Minutes a project-file download link from the app keeps working
FILE_LINK_MINUTES=60
# Sent on that POST: Type (Channel Partner) and, optionally, the Salesforce user who owns new accounts
SALESFORCE_PARTNER_TYPE=Channel Partner
# Account record type "Channel Partner" Id (differs per org); empty = looked up by name
SALESFORCE_PARTNER_RECORD_TYPE_ID=
SALESFORCE_PARTNER_OWNER_ID=
SALESFORCE_WEBHOOK_SECRET=

# Email login codes (fallback login) and HOD emails: console = print them in the server log (development); smtp = send
EMAIL_PROVIDER=console
SMTP_HOST=
# 587 + starttls (most providers, e.g. Office 365, Gmail, SES), 465 + ssl, or none for a local relay
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ambuja Neotia Partners

# Login codes by SMS (the app's default login). Admins can enter the Gupshup details in the portal instead
# (Settings -> SMS); saved portal details take priority over these. console = print them in the server log (development);
# gupshup = send through Gupshup's Enterprise SMS API. All GUPSHUP_* values come from the client's
# Gupshup account and DLT registration.
SMS_PROVIDER=console
# TEMPORARY testing only: while SMS isn't set up, write mobile login codes to the server log
# (journalctl -u broker-api) instead of failing. Remove once SMS or WhatsApp works.
# TEST_LOGIN_CODES_IN_LOG=true
GUPSHUP_USERID=
GUPSHUP_PASSWORD=
# 6-letter DLT-approved header (sender ID), e.g. AMBNEO
GUPSHUP_SENDER_ID=
# DLT Principal Entity (PE) ID, and the Template ID of the approved OTP template
GUPSHUP_ENTITY_ID=
GUPSHUP_TEMPLATE_ID=
# Exactly the approved template text, with {code} where the DLT template has {#var#}
# SMS_LOGIN_TEMPLATE={code} is your OTP to log in to the Ambuja Neotia Partners app. It is valid for 5 minutes. Do not share it with anyone. - Ambuja Neotia
# Codes per mobile/email per hour (caps SMS spend)
OTP_MAX_PER_HOUR=5

# Only if "enhanced push security" is enabled for the Expo project
EXPO_ACCESS_TOKEN=
