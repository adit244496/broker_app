{
  "expo": {
    "name": "Ambuja Neotia Partners",
    "slug": "broker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ambujaneotia.brokerapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C4F78",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ambujaneotia.brokerapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1C4F78"
        }
      ]
    ],
    "scheme": "brokerapp",
    "experiments": {
      "typedRoutes": true
    }
  }
}
